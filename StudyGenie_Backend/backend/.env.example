PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=
# Choose a model that is enabled for your Google AI project.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional separate cleaner key/model. Leave key blank to reuse GEMINI_API_KEY.
CLEANER_GEMINI_API_KEY=
CLEANER_GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_AI_TRANSCRIPT_CLEANER=true

# Python worker
# Leave as python to auto-detect backend/.venv, or set an explicit path.
PYTHON_BIN=python
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
MAX_VIDEO_MINUTES=180

# Storage / behavior
TMP_DIR=./tmp
AUTO_GENERATE_NOTES=true

# Optional worker limits
WORKER_TIMEOUT_MS=7200000
MAX_CONCURRENT_TRANSCRIPTIONS=1
